# ExitLane environment variables
# Copy this file to .env.local and supply real values.
# Never commit .env.local.
# This file must contain variable names and explanatory comments only —
# no credentials, no realistic-looking secret values.

# ── Privy ──────────────────────────────────────────────────────────────────────
# Application ID — exposed to the browser via the Privy client SDK.
# Found in: Privy Dashboard → Settings → App ID
NEXT_PUBLIC_PRIVY_APP_ID=

# Client ID — optional, used when you have multiple app clients (e.g. staging vs prod).
# Found in: Privy Dashboard → App Clients. If omitted, Privy uses the default app client.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Application secret — server-side only; never expose to the client bundle.
PRIVY_APP_SECRET=

# ── Privy dashboard checklist ──────────────────────────────────────────────────
# Before the login button becomes active, the Privy dashboard must have:
#   1. http://localhost:3000  listed under Settings → Allowed origins (development)
#   2. At least one login method enabled (e.g. Email and/or External wallet)
#   3. NEXT_PUBLIC_PRIVY_APP_ID must match the App ID shown in the dashboard

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Claude API key — server-side only.
# Used exclusively for the two constrained AI workflows:
#   1. Structured mandate draft from plain-language input.
#   2. Plain-language explanation of deterministic policy evidence.
# AI output is never trusted for authorization.
ANTHROPIC_API_KEY=

# ── The Graph ──────────────────────────────────────────────────────────────────
# API key for The Graph decentralized network — server-side only.
GRAPH_API_KEY=

# Subgraph deployment ID or URL for the configured evidence network.
GRAPH_SUBGRAPH_ID=

# ── EVM RPC ────────────────────────────────────────────────────────────────────
# RPC endpoint for the mainnet evidence source (read-only; no signing).
RPC_URL_MAINNET=

# RPC endpoint for the execution network (e.g. Base Sepolia for the demo).
RPC_URL_EXECUTION=

# ── Chain configuration ────────────────────────────────────────────────────────
# Chain ID for live market evidence (integer, e.g. 8453 for Base mainnet).
EVIDENCE_CHAIN_ID=

# Chain ID for mandate execution (integer, e.g. 84532 for Base Sepolia).
EXECUTION_CHAIN_ID=

# ── Demo safety ────────────────────────────────────────────────────────────────
# Hard upper bound on the ETH amount the demo may execute, in wei (integer string).
# Independent of any individual mandate constraint.
DEMO_MAX_AMOUNT_WEI=

# ── Session integrity ──────────────────────────────────────────────────────────
# Secret for API request signing / session tokens. Minimum 32 characters.
APP_SESSION_SECRET=

# ── AI model selection ──────────────────────────────────────────────────────────
# Model identifier used for both constrained AI workflows — server-side only.
# The browser never sends or receives this value.
# The model is never accepted from request bodies.
# Hackathon default: claude-sonnet-5
ANTHROPIC_MODEL=
